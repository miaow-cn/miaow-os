{
        "version": "0.2.0",
        "configurations": [
                {
                        "name": "QEMU kernel debug",
                        "type": "cppdbg",
                        "request": "launch",
                        "program": "${workspaceFolder}/build/kernel.elf",
                        "cwd": "${workspaceFolder}",
                        "MIMode": "gdb",
                        "targetArchitecture": "arm64",
                        "miDebuggerPath": "/usr/sbin/gdb",
                        "miDebuggerServerAddress": "localhost:1234",
                        "stopAtEntry": true,
                        "launchCompleteCommand": "exec-continue",
                        "preLaunchTask": "qemu-gdb",
                        "postDebugTask": "kill-qemu",
                        "postRemoteConnectCommands": [
                                {
                                        "description": "Stop at the kernel entry point",
                                        "text": "-break-insert -t _start",
                                        "ignoreFailures": false
                                }
                        ],
                        "setupCommands": [
                                {
                                        "description": "Enable pretty printing",
                                        "text": "set print pretty on"
                                }
                        ]
                }
        ]
}